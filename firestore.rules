rules_version = '2';

// Demo / internal app rules: open read/write on app collections.
// Before production: add Firebase Auth (or App Check) and restrict writes to signed-in users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventory/{materialId} {
      allow read, write: if true;
    }

    match /vendors/{vendorId} {
      allow read, write: if true;
    }

    match /userOrders/{orderId} {
      allow read, write: if true;
    }

    match /vendorMessages/{messageId} {
      allow read, write: if true;
    }
  }
}
